# Copy to .env and replace every value. Never commit .env.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flowlane
DB_USERNAME=flowlane_app
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# Security: at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D
# true in any deployment served over HTTPS
COOKIE_SECURE=false

# Web
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Files and jobs
STORAGE_DIR=./data/uploads
REMINDER_CRON="0 0 8 * * *"

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM="Flowlane <onboarding@resend.dev>"


